@host = http://localhost:5149

GET {{host}}/api/metadata/entities

###
GET {{host}}/api/metadata/entities/Delivery/fields?depth=2

###
GET {{host}}/api/metadata/operators

###
GET {{host}}/api/controls

###
POST {{host}}/api/controls/validate
Content-Type: application/json

{ "definition": { "version": 1, "rootEntity": "Delivery",
  "condition": { "type": "rule", "field": "PackageWeightKg", "operator": "gt", "compareTo": { "kind": "field", "field": "Drone.MaxPayloadKg" } } } }

###
POST {{host}}/api/controls/1/runs

###
GET {{host}}/api/runs?controlId=1

###
GET {{host}}/api/runs/1/violations?page=1&pageSize=20&sortBy=PackageWeightKg&sortDir=desc

### AI: free text -> proposed control (needs the AI service on :8001)
POST {{host}}/api/ai/suggest-control
Content-Type: application/json

{ "text": "רחפן פעיל במוקד סגור" }

