{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DroneOps": "Server=localhost\\SQLEXPRESS;Database=DroneOpsControls;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "ControlExecution": {
    "MaxRows": 1000,
    "CommandTimeoutSeconds": 30,
    "PreviewMaxRows": 100,
    "PreviewDefaultRows": 50,
    "RunnerUser": "controls_runner"
  },
  "Metadata": {
    "CacheSeconds": 300
  },
  "AiService": {
    "BaseUrl": "http://localhost:8001",
    "TimeoutSeconds": 30
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  }
}
