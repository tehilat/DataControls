# Files for the development environment only (Angular's generated AI instructions, editor settings).
# They stay in the repository but are left out of exported archives (git archive -o DataControls.zip HEAD).
# The root CLAUDE.md is included on purpose: it is the project's working guide, referenced in docs/ai-tools.md.
frontend/CLAUDE.md export-ignore
frontend/.mcp.json export-ignore
frontend/.vscode export-ignore
frontend/.vscode/** export-ignore

# docs/submission.html is generated by tools/md_to_html.py, which writes CRLF. A fixed line ending keeps
# a regeneration with unchanged content from showing up as a modification.
docs/submission.html text eol=crlf
